. esttab using "$drive\tabs\Table2.tex", se keep(dchoice hchoice hdchoice) scalars("hasfe Fixed Effect" "hascon Controls") nomtitles mgroups("Hypothesis 3", pattern(1 0 0 0 0) ///
>   prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-}) span) ///
>        nonotes addnote("OLS regressions of the amount experimental participants donated to charity on two treatment variables: the Options variable measures whether they could see 40 charities versus 5; the Default variable measures whether they had access to a pre-selected charity to donate to, meaning they did not had to make a decision. Individual fixed effects can be included for the Options treatment because there is within-participant variation in the number of charities seen, but the Default treatment is between-participant. Covariates include education level, race, marital status, employment status, religion, income, age, and gender." "Standard errors in parentheses, clustered by individual" "\sym{c -(}*{c )-} \(p<0.10\), \sym{c -(}**{c )-} \(p<0.05\), \sym{c -(}***{c )-} \(p<0.01\)") ///
>  alignment(c) label replace ///
>       title (Effect of Default Treatment on Donations \label{c -(}Table2{c )-})
{res}{txt}(output written to {browse  `"C:\Users\AtiyehYeganloo\OneDrive - Judge Business School\_U of Cambridge\_Research Projects\0_Donation, choice overload\Data Analysis\Shared DataAnalysis\tabs\Table2.tex"'})

