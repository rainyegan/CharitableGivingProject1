{com}. 
. 
. *Include people who do not donate in one of the rounds, but not those who opt out at the start ('selfish' people)
. recode donation (.=0) if Donors!=0
{txt}(419 changes made to {bf:donation})

{com}. 
. *Options treatment - defined for whole sample
. gen hchoice = .
{txt}(6,400 missing values generated)

{com}. replace hchoice = 1 if Treatments<=3 & round==2
{txt}(556 real changes made)

{com}. replace hchoice = 1 if Treatments<=6 & Treatments>3 & round==1
{txt}(565 real changes made)

{com}. replace hchoice = 1 if Treatments<=12 & Treatments>9 
{txt}(1,118 real changes made)

{com}. replace hchoice = 0 if Treatments<=3 & round==1
{txt}(556 real changes made)

{com}. replace hchoice = 0 if Treatments<=6 & Treatments>3 & round==2
{txt}(565 real changes made)

{com}. replace hchoice = 0 if Treatments<=9 & Treatments>6 
{txt}(1,136 real changes made)

{com}. replace hchoice = 1 if Treatments==13
{txt}(378 real changes made)

{com}. replace hchoice = 0 if Treatments==14
{txt}(372 real changes made)

{com}. replace hchoice = 0 if Category==1 & Treatments==15
{txt}(88 real changes made)

{com}. replace hchoice = 1 if Category>1 & Category!=. & Treatments==15
{txt}(286 real changes made)

{com}. replace hchoice = 0 if Category>1 & Category!=. & Treatments==16
{txt}(290 real changes made)

{com}. replace hchoice = 0 if Category==1 & Treatments==16
{txt}(90 real changes made)

{com}. 
. 
. *ESTIMATIONS FOR 1 VERSUS MANY CHOICES (Missing for default and importance arms)
. gen mchoice = .
{txt}(6,400 missing values generated)

{com}. replace mchoice = 0 if Treatments==1 | Treatments == 4 | Treatments == 7 | Treatments == 10 
{txt}(1,500 real changes made)

{com}. replace mchoice = 1 if Treatments==3 | Treatments == 6 |  Treatments == 9 | Treatments == 12 
{txt}(1,484 real changes made)

{com}. 
. *ESTIMATIONS FOR DEFAULT VERSUS NON DEFAULT (Missing for mchoice and importance arms)
. gen dchoice = .
{txt}(6,400 missing values generated)

{com}. replace dchoice = 0 if Treatments==1 | Treatments == 4 | Treatments == 7 | Treatments == 10 
{txt}(1,500 real changes made)

{com}. replace dchoice = 1 if Treatments==2 | Treatments == 5 |  Treatments == 8 | Treatments == 11 
{txt}(1,512 real changes made)

{com}. 
. label variable hchoice "Options"
{txt}
{com}. label variable mchoice "Choices"
{txt}
{com}. label variable dchoice "Default"
{txt}
{com}. label variable schoice "Select"
{txt}
{com}. label variable round "Round" 
{txt}
{com}. 
. 
. *Four main hypotheses 
. 
. gen hmchoice = hchoice*mchoice
{txt}(3,416 missing values generated)

{com}. label variable hmchoice "Options * Choices "
{txt}
{com}. 
. gen hdchoice = hchoice*dchoice
{txt}(3,388 missing values generated)

{com}. label variable hdchoice "Options * Default"
{txt}
{com}. 
. gen hschoice = hchoice*schoice
{txt}(400 missing values generated)

{com}. label variable hschoice "Options * Select"
{txt}
{com}. 
. gen temp_round = round - 1
{txt}
{com}. label variable temp_round "Round"
{txt}
{com}. 
. gen hrchoice = hchoice*temp_round
{txt}(400 missing values generated)

{com}. label variable hrchoice "Options * Round "
{txt}
{com}. 
. gen mrchoice = mchoice*temp_round
{txt}(3,416 missing values generated)

{com}. label variable mrchoice "Choice * Round"
{txt}
{com}. 
. gen hmrchoice = hchoice*mchoice*temp_round
{txt}(3,416 missing values generated)

{com}. label variable hmrchoice "Options * Choice * Round"
{txt}
{com}. 
. 
. label define hchoicel 0 "Low" 1 "High"
{txt}
{com}. 
. label values hchoice hchoicel
{txt}
{com}. 
. label define mchoicel 0 "One" 1 "Many"
{txt}
{com}. 
. label values mchoice mchoicel
{txt}
{com}. 
. label define dchoicel 0 "No Default" 1 "Default"
{txt}
{com}. 
. label values dchoice dchoicel
{txt}
{com}. 
. label define schoicel 0 "Not Selected" 1 "Selected"
{txt}
{com}. 
. label values schoice schoicel
{txt}
{com}. 
