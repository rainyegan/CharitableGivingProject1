{com}. label variable dchoicemarr "Default * Married"
{txt}
{com}. label variable dchoiceemployed "Default * Employed"
{txt}
{com}. label variable dchoiceatheist "Default * Atheist"
{txt}
{com}. label variable dchoiceinc "Default * Income"
{txt}
{com}. label variable dchoiceage "Default * Age"
{txt}
{com}. label variable dchoicemaledum "Default * Male"
{txt}
{com}. 
. gen revealdegree = reveal*degree
{txt}(112 missing values generated)

{com}. gen revealwhite = reveal*white
{txt}
{com}. gen revealmarr = reveal*marr    
{txt}(868 missing values generated)

{com}. gen revealemployed = reveal*employed  
{txt}
{com}. gen revealatheist = reveal*atheist
{txt}
{com}. gen revealinc = reveal*inc
{txt}(248 missing values generated)

{com}. gen revealage = reveal*age
{txt}
{com}. gen revealmaledum = reveal*maledum
{txt}(62 missing values generated)

{com}. 
. label variable revealdegree "Reveal * Degree"
{txt}
{com}. label variable revealwhite "Reveal * White"
{txt}
{com}. label variable revealmarr "Reveal * Married"
{txt}
{com}. label variable revealemployed "Reveal * Employed"
{txt}
{com}. label variable revealatheist "Reveal * Atheist"
{txt}
{com}. label variable revealinc "Reveal * Income"
{txt}
{com}. label variable revealage "Reveal * Age"
{txt}
{com}. label variable revealmaledum "Reveal * Male"
{txt}
{com}. 
. foreach var in hchoice mchoice dchoice  {c -(}
{txt}  2{com}.         
.         eststo clear
{txt}  3{com}.         
.         eststo: reg donation `var' if TreatmentSignal==0 , cluster(id)
{txt}  4{com}. 
. foreach x in degree white marr employed atheist inc age maledum {c -(}
{txt}  5{com}. 
. eststo: reg donation `x' `var' `var'`x' if TreatmentSignal==0  , cluster(id)
{txt}  6{com}. 
. {c )-}
{txt}  7{com}. 
. 
. esttab using "$drive\tabs\Table`var'covs.tex", se  star(* 0.10 ** 0.05 *** 0.01) keep(`var' degree white marr employed atheist inc age maledum `var'degree `var'white `var'marr `var'employed `var'atheist `var'inc `var'age `var'maledum) nomtitles mgroups("Donations (Tokens)", pattern(1 0 0 0 0 0 0 0) ///
>   prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-}) span) ///
>        nonotes addnote("OLS regressions of the amount experimental participants donated to on the treatment variable using eight demographic variables as moderators: whether participant has a bachelor's degree or higher (versus high school or less); whether they are White British (versus all other ethnicities); whether they are employed (part-time or full-time versus out of employment for any reason); whether they are married (versus never married); whether they are an atheist (versus any religion); their income; their age; and whether they are male (versus female). In columns (2), (4), and (7), some data is lost as ambiguous categories are coded as missing to facilitate a clear interpretation of the dummy variable." "\sym{c -(}*{c )-} \(p<0.10\), \sym{c -(}**{c )-} \(p<0.05\), \sym{c -(}***{c )-} \(p<0.01\)") ///
>  alignment(c) label replace ///
>       title (Effect of `var' on Donations Using Demographic Moderators \label{c -(}Table`var'covs{c )-})
{txt}  8{com}. 
.           {c )-}

