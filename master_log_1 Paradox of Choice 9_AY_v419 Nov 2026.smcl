. esttab using "$drive\tabs\Tablemods.tex", se keep(hchoice SRA hchoiceSRA avoid hchoiceavoid max hchoicemax give hchoicegive vol hchoicevol hchoicemon mchoice mchoiceSRA mchoiceavoid mchoicemax mchoicegive mchoicevol mchoicemon dchoice dchoiceSRA dchoiceavoid dchoicemax dchoicegive dchoicevol dchoicemon) nomtitles mgroups("Donations (Tokens)", pattern(1 0 0 0) ///
>   prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-}) span) ///
>        nonotes addnote("OLS regressions of the amount experimental participants donated to on the four treatment variables: the options treatment; the choices treatment; the default treatment; the signal treatment. Each regressions also includes six moderator variables and their interactions with the treatments: altruism; avoidant decision-making; maximising versus satisficing behaviour; and prior involvement in charitable giving, both volunteering and donations." "Standard errors in parentheses, clustered by individual" "\sym{c -(}*{c )-} \(p<0.10\), \sym{c -(}**{c )-} \(p<0.05\), \sym{c -(}***{c )-} \(p<0.01\)") ///
>  alignment(c) label replace ///
>       title (Effect of Treatments on Donations Using Selected Moderators \label{c -(}Tablemods{c )-})
