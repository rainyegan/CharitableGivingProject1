{txt}  4{com}.         replace `var'_temp_num = 2 if `var' == "Probably yes"
{txt}  5{com}.         replace `var'_temp_num = 3 if `var' == "Might or might not"
{txt}  6{com}.     replace `var'_temp_num = 4 if `var' == "Probably not"    
{txt}  7{com}.     replace `var'_temp_num = 5 if `var' == "Definitely not"
{txt}  8{com}.     
.     
.     label define `var'_temp_num_lbl 2 "Probably yes" ///
>                                      4 "Probably not" ///
>                                      3 "Might or might not" ///
>                                      5 "Definitely not" ///
>                                      1 "Definitely yes"
{txt}  9{com}.                                                                          
.     label values `var'_temp_num `var'_temp_num_lbl
{txt} 10{com}.     
.     rename `var'_temp_num `var'_temp
{txt} 11{com}. {c )-}
