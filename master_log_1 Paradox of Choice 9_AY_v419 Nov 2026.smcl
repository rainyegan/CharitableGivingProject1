. gen temp_donated = . 
{txt}(6,400 missing values generated)

{com}. replace temp_donated = 1 if temp_donation > 1 
{txt}(5,686 real changes made)

{com}. replace temp_donated = 0 if temp_donation < 2 
{txt}(714 real changes made)

{com}. 
. gen temp_donated_mchoice = temp_donated* temp_mchoice_subset
{txt}(5,655 missing values generated)

{com}. gen temp_donated_hchoice = temp_donated* temp_hchoice_subset_r1
{txt}(5,273 missing values generated)

{com}. gen temp_donated_mhchoice = temp_donated* temp_hchoice_subset_r1*temp_mchoice_subset
{txt}(5,655 missing values generated)

{com}. 
. 
. eststo clear
