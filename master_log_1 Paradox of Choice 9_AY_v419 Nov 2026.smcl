>        nonotes addnote("Nine OLS regressions of three subjective variables on three treatments. The subjective variables are: how difficult participants reported finding the choices; how long they deliberated over them; and how familiar they were with the listed charities. The treatments are: the options treatment, which measures whether participants had 40 versus 5 charities to choose from; the choices treatment, which measures whether participants could donate to multiple versus just one charity; and the default treatment, which measures whether they could use a pre-selected default donation option instead of choosing manually." "Standard errors in parentheses, clustered by individual" "\sym{c -(}*{c )-} \(p<0.10\), \sym{c -(}**{c )-} \(p<0.05\), \sym{c -(}***{c )-} \(p<0.01\)") ///
>  alignment(c) label replace ///
>       title (Effect of Treatment on Subjective Variables \label{c -(}Table10{c )-})         
{res}{txt}(output written to {browse  `"C:\Users\AtiyehYeganloo\OneDrive - Judge Business School\_U of Cambridge\_Research Projects\0_Donation, choice overload\Data Analysis\Shared DataAnalysis\tabs\Table10.tex"'})

{com}.           
. 
. 
.           
. *Charitable Giving
. 
. *How much donated
. encode charitablegiving, gen(charitablegiving_temp)
{txt}
{com}. recode charitablegiving_temp (1=150) (2=350) (3=.) (4=62.5) (5=1000) (6=87.5), gen(give)
{txt}(6,400 differences between {bf:charitablegiving_temp} and {bf:give})

{com}. label variable give "Money Donated"
{txt}
{com}. 
.     replace charitablegiving_temp = 1 if charitablegiving == "£50-£75"
{txt}(1,768 real changes made)

{com}.         replace charitablegiving_temp = 2 if charitablegiving == "£75-£100"
{txt}(1,452 real changes made)

{com}.         replace charitablegiving_temp = 3 if charitablegiving == "£101-£200"
{txt}(1,548 real changes made)

{com}.     replace charitablegiving_temp = 4 if charitablegiving == "£201-£500"    
{txt}(1,044 real changes made)

{com}.     replace charitablegiving_temp = 5 if charitablegiving == "£501+"
{txt}(0 real changes made)

{com}.       replace charitablegiving_temp = . if charitablegiving == "£201-£500, £101-£200"
{txt}(2 real changes made, 2 to missing)

{com}.    
.     
.     label define charitablegiving_temp_lbl  5 "£501+" ///
>                                      4 "£201-£500" ///
>                                      3 "£101-£200" ///
>                                      2 "£75-£100" ///
>                                      1 "£50-£75"
{txt}
{com}.                                                                          
.     label values charitablegiving_temp charitablegiving_temp_lbl
{txt}
{com}.     
. 
. 
. encode PreferenceGiving, gen(PreferenceGiving_temp)
{txt}
{com}. gen vol = (PreferenceGiving_temp==3)
{txt}
{com}. gen mon = (PreferenceGiving_temp==2)
{txt}
{com}. label variable vol "Prefers Volunteering"
{txt}
{com}. label variable mon "Prefers Donating"
{txt}
{com}. 
. *Personality varibles moderators
. gen hchoiceSRA = SRA*hchoice
{txt}(400 missing values generated)

{com}. gen hchoiceavoid = avoid*hchoice
{txt}(400 missing values generated)

{com}. gen hchoicemax = max*hchoice
{txt}(400 missing values generated)

{com}. gen hchoicegive = give*hchoice
{txt}(402 missing values generated)

{com}. gen hchoicevol = vol*hchoice
{txt}(400 missing values generated)

{com}. gen hchoicemon = mon*hchoice
{txt}(400 missing values generated)

{com}. label variable hchoiceSRA "Options * Altruism"
{txt}
{com}. label variable hchoiceavoid "Options * Avoidance"
{txt}
{com}. label variable hchoicemax "Options * Maximiser"
{txt}
{com}. label variable hchoicegive "Options * Money Donated"
{txt}
{com}. label variable hchoicevol "Options * Prefers Volunteering"
{txt}
{com}. label variable hchoicemon "Options * Prefers Donating"
{txt}
{com}. 
. gen mchoiceSRA = SRA*mchoice
{txt}(3,416 missing values generated)

{com}. gen mchoiceavoid = avoid*mchoice
{txt}(3,416 missing values generated)

{com}. gen mchoicemax = max*mchoice
{txt}(3,416 missing values generated)

{com}. gen mchoicegive = give*mchoice
{txt}(3,418 missing values generated)

{com}. gen mchoicevol = vol*mchoice
{txt}(3,416 missing values generated)

{com}. gen mchoicemon = mon*mchoice
{txt}(3,416 missing values generated)

{com}. label variable mchoiceSRA "Choices * Altruism"
{txt}
{com}. label variable mchoiceavoid "Choices * Avoidance"
{txt}
{com}. label variable mchoicemax "Choices * Maximiser"
{txt}
{com}. label variable mchoicegive "Choices * Money Donated"
{txt}
{com}. label variable mchoicevol "Choices * Prefers Volunteering"
{txt}
{com}. label variable mchoicemon "Choices * Prefers Donating"
{txt}
{com}. 
. gen dchoiceSRA = SRA*dchoice
{txt}(3,388 missing values generated)

{com}. gen dchoiceavoid = avoid*dchoice
{txt}(3,388 missing values generated)

{com}. gen dchoicemax = max*dchoice
{txt}(3,388 missing values generated)

{com}. gen dchoicegive = give*dchoice
{txt}(3,390 missing values generated)

{com}. gen dchoicevol = vol*dchoice
{txt}(3,388 missing values generated)

{com}. gen dchoicemon = mon*dchoice
{txt}(3,388 missing values generated)

{com}. label variable dchoiceSRA "Default * Altruism"
{txt}
{com}. label variable dchoiceavoid "Default * Avoidance"
{txt}
{com}. label variable dchoicemax "Default * Maximiser"
{txt}
{com}. label variable dchoicegive "Default * Money Donated"
{txt}
{com}. label variable dchoicevol "Default * Prefers Volunteering"
{txt}
{com}. label variable dchoicemon "Default * Prefers Donating"
{txt}
{com}. 
. gen revealSRA = SRA*reveal
{txt}
{com}. gen revealavoid = avoid*reveal
{txt}
{com}. gen revealmax = max*reveal
{txt}
{com}. gen revealgive = give*reveal
{txt}(2 missing values generated)

{com}. gen revealvol = vol*reveal
{txt}
{com}. gen revealmon = mon*reveal
{txt}
{com}. label variable revealSRA "Reveal * Altruism"
{txt}
{com}. label variable revealavoid "Reveal * Avoidance"
{txt}
{com}. label variable revealmax "Reveal * Maximiser"
{txt}
{com}. label variable revealgive "Reveal * Money Donated"
{txt}
{com}. label variable revealvol "Reveal * Prefers Volunteering"
{txt}
{com}. label variable revealmon "Reveal * Prefers Donating"
{txt}
{com}. 
. label variable avoid "Avoidance"
{txt}
{com}. label variable max "Maximiser"
{txt}
{com}. label variable SRA "Altruism (SRA)"
{txt}
{com}. 
. 
. foreach var in hchoice mchoice {c -(}
{txt}  2{com}.         
.         eststo clear
{txt}  3{com}.         
.         eststo: reg donation `var', cluster(id), if TreatmentSignal==0 & TreatmentChoice!=2
{txt}  4{com}. 
. foreach x in SRA avoid max give {c -(}
{txt}  5{com}. 
. eststo: reg donation `x' `var' `var'`x', cluster(id), if TreatmentSignal==0 & TreatmentChoice!=2
{txt}  6{com}. 
. {c )-}
{txt}  7{com}. 
. 
. eststo: reg donation `var' vol mon `var'vol `var'mon, cluster(id), if TreatmentSignal==0 & TreatmentChoice!=2
{txt}  8{com}. 
. esttab using "$drive\tabs\Table`var'.tex", se  star(* 0.10 ** 0.05 *** 0.01) keep(`var' SRA avoid max give vol mon `var'SRA `var'avoid `var'max `var'give `var'vol `var'mon) nomtitles mgroups("Donations (Tokens)", pattern(1 0 0 0 0 0) ///
>   prefix(\multicolumn{c -(}@span{c )-}{c -(}c{c )-}{c -(}) suffix({c )-}) span) ///
>        nonotes addnote("OLS regressions of the amount experimental participants donated to on the treatment variable using six moderator variables: altruism; avoidant decision-making; maximising versus satisficing behaviour; and prior involvement in charitable giving, both volunteering and donations." "Standard errors in parentheses, clustered by individual" "\sym{c -(}*{c )-} \(p<0.10\), \sym{c -(}**{c )-} \(p<0.05\), \sym{c -(}***{c )-} \(p<0.01\)") ///
>  alignment(c) label replace ///
>       title (Effect of `var' Treatment on Donations Using Selected Moderators \label{c -(}Table`var'{c )-})
{txt}  9{com}. 
