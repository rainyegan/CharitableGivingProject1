>     nonotes addnote("TEXT", ///
>     "Standard errors in parentheses, clustered by individual.", ///
>     "\sym{c -(}*{c )-} \(p<0.10\), \sym{c -(}**{c )-} \(p<0.05\), \sym{c -(}***{c )-} \(p<0.01\)" ) ///
